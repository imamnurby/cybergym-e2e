{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["codings"],
  "properties": {
    "codings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_uid",
          "action_label",
          "object_label",
          "discourse_role",
          "subject_label",
          "summary",
          "evidence",
          "confidence"
        ],
        "properties": {
          "event_uid": {"type": "string"},
          "action_label": {"type": ["string", "null"]},
          "object_label": {"type": ["string", "null"]},
          "discourse_role": {"type": ["string", "null"]},
          "subject_label": {"type": ["string", "null"]},
          "summary": {"type": "string"},
          "evidence": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    }
  }
}
